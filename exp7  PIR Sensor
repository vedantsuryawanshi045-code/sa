void setup()
{
    pinMode(2, INPUT);
    pinMode(13, OUTPUT);
    Serial.begin(9600);
}
void loop()
{
    int motion = digitalRead(2);
    if (motion == HIGH)
    {
        digitalWrite(13, HIGH);
        Serial.println("Motion Detected");
    }
    else
    {
        digitalWrite(13, LOW);
        Serial.println("No Motion Detected");
    }
    delay(1000);
}
